Cell[CellGroupData[{

Cell["Displaying Dice on top of Discard Pile", "Section",
 CellChangeTimes->{{3.976214891903632*^9, 
  3.9762149009800014`*^9}},ExpressionUUID->"e5823cd4-894e-474b-bb8f-\
1e7812308b0e"],

Cell["\<\
Some enemy attacks modify the behavior of discarded dice (For a Shark\
\[CloseCurlyQuote]s Chomp Chomp!, all discarded cards go into the Shark\
\[CloseCurlyQuote]s Belly that round). They say to place the die \
\>", "Text",
 CellChangeTimes->{{3.97621506376513*^9, 
  3.9762151445352726`*^9}},ExpressionUUID->"15a5e063-1121-4feb-ac7a-\
7bb360820571"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"backside", "=", 
   RowBox[{
   "Import", "[", 
    "\"\<C:\\\\Users\\\\fam\\\\Documents\\\\Programming\\\\BoardGameArena\\\\\
weresinking\\\\.img\\\\Water Deck\\\\WaterDeckBackside.png\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angered", "=", 
   RowBox[{
   "Import", "[", 
    "\"\<C:\\\\Users\\\\fam\\\\Documents\\\\Programming\\\\BoardGameArena\\\\\
weresinking\\\\.img\\\\Dice\\\\Kraken\\\\Kraken2.png\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chompchomp", " ", "=", " ", 
    RowBox[{
    "Import", "[", 
     "\"\<C:\\\\Users\\\\fam\\\\Documents\\\\Programming\\\\BoardGameArena\\\\\
weresinking\\\\.img\\\\Dice\\\\Shark\\\\Shark1.png\>\"", "]"}]}], ";", 
   RowBox[{"scale", "=", "48"}], ";", " ", 
   RowBox[{"cardWidth", "=", 
    RowBox[{"2.5", "*", "scale"}]}], ";", " ", 
   RowBox[{"diceWidth", " ", "=", " ", 
    RowBox[{
     RowBox[{"5", "/", "8"}], "*", "scale"}]}], ";", " ", 
   RowBox[{"margin", "=", "15"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backside", "=", 
   RowBox[{"Rasterize", "[", 
    RowBox[{"backside", ",", 
     RowBox[{"ImageSize", "\[Rule]", " ", "cardWidth"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backsideNoMargins", "=", 
   RowBox[{"Rasterize", "@", 
    RowBox[{"Framed", "[", 
     RowBox[{"backside", ",", 
      RowBox[{"ImageSize", "\[Rule]", "120"}], ",", 
      RowBox[{"FrameStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", " ", "Gray"}], "}"}]}], ",", " ", 
      RowBox[{"RoundingRadius", "\[Rule]", " ", "10"}], ",", 
      RowBox[{"FrameMargins", "\[Rule]", "0"}], ",", " ", 
      RowBox[{"Background", "\[Rule]", "White"}], ",", 
      RowBox[{"ImageMargins", "\[Rule]", " ", "0"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"backsideWithMargins", "=", 
    RowBox[{"Rasterize", "@", 
     RowBox[{"Framed", "[", 
      RowBox[{"backside", ",", 
       RowBox[{"ImageSize", "\[Rule]", "120"}], ",", 
       RowBox[{"FrameStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", " ", "Gray"}], "}"}]}], ",", " ", 
       RowBox[{"RoundingRadius", "\[Rule]", " ", "10"}], ",", 
       RowBox[{"FrameMargins", "\[Rule]", "0"}], ",", " ", 
       RowBox[{"Background", "\[Rule]", "White"}], ",", 
       RowBox[{"ImageMargins", "\[Rule]", " ", "margin"}]}], "]"}]}]}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"angered", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Rasterize", "[", 
       RowBox[{"angered", ",", " ", 
        RowBox[{"ImageSize", "\[Rule]", " ", "diceWidth"}]}], "]"}], 
      "\[IndentingNewLine]", "chompchomp"}], " ", "=", " ", 
     RowBox[{"Rasterize", "[", 
      RowBox[{"chompchomp", ",", " ", 
       RowBox[{"ImageSize", "\[Rule]", " ", "diceWidth"}]}], "]"}]}]}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rotated", "[", 
    RowBox[{"img_", ",", "theta_"}], "]"}], ":=", " ", 
   RowBox[{"Rasterize", "[", 
    RowBox[{
     RowBox[{"ImageRotate", "[", 
      RowBox[{"img", ",", "theta", ",", " ", 
       RowBox[{"Background", "\[Rule]", " ", "Transparent"}]}], "]"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", " ", "diceWidth"}], ",", " ", 
     RowBox[{"Background", "\[Rule]", "None"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rotated", "[", "img_", "]"}], ":=", 
   RowBox[{"rotated", "[", 
    RowBox[{"img", ",", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"2", "Pi"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
